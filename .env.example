# Copy this file to .env and fill in real values. .env is git-ignored; this file is public.
# Never put the service_role / secret key here or in any VITE_* variable.

# Frontend (safe to expose; protected only by RLS). Supabase dashboard > Project Settings > API keys.
VITE_SUPABASE_URL=https://<dev-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<dev-publishable-or-anon-key>

# Backup script only (scripts/backup-supabase.mjs). Supabase > Connect > Session pooler.
# Special characters in the password must be percent-encoded (@ -> %40, # -> %23, / -> %2F).
SUPABASE_DEV_DB_URL=postgresql://postgres.<dev-project-ref>:[YOUR-PASSWORD]@<region>.pooler.supabase.com:5432/postgres

# Do NOT put production connection strings or keys in this file.
